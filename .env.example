# Copia este archivo como .env.local. En Vercel agrega la variable en Settings > Environment Variables.
# ÚNICO valor obligatorio: pega aquí la clave creada en Google AI Studio.
GEMINI_API_KEY=

# Modelo con nivel gratuito, sujeto a las cuotas de tu proyecto de Google.
GEMINI_MODEL=gemini-3.1-flash-lite
